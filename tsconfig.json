{
	"compilerOptions": {
		"target": "ES2022",
		"module": "node16",
		"moduleResolution": "node16",
		"lib": ["ES2022"],
		"outDir": "dist",
		"rootDir": ".",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"declaration": false,
		"sourceMap": true,
		"types": ["node", "jest"]
	},
	"include": ["nodes/**/*.ts", "credentials/**/*.ts"],
	"exclude": ["node_modules", "dist", "**/__tests__/**"]
}

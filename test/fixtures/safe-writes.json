				"conditions": {
					"options": {
						"caseSensitive": true,
						"leftValue": "",
						"typeValidation": "strict",
						"version": 3
					},
					"conditions": [
						{
							"id": "c0c",
							"leftValue": "={{ ((items) => (items.every((j) => !j.error)) && (items.every((j) => [\"throttling\",\"is_scheduled\"].every((k) => k in j))))($('Speed Mode: before').all().map((i) => i.json)) }}",
							"rightValue": "",
							"operator": {
								"type": "boolean",
								"operation": "true",
								"singleValue": true
							}
						}
					],
					"combinator": "and"
				},
				"options": {}
			}
		},

			"typeVersion": 1,
			"position": [
				660,
				200
			],
			"parameters": {
				"errorMessage": "={{ ((items) => \"Speed Mode: before: expected \" + [[\"no error\", (items.every((j) => !j.error))], [\"keys throttling, is_scheduled\", (items.every((j) => [\"throttling\",\"is_scheduled\"].every((k) => k in j)))]].filter((pair) => !pair[1]).map((pair) => pair[0]).join(', ') + '; got ' + JSON.stringify(items).slice(0, 400))($('Speed Mode: before').all().map((i) => i.json)) }}"
			}
		},
